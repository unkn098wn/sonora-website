{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonora-website",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "."
  },
  "kv_namespaces": [
    {
      "binding": "SONORA_KV",
      "id": "ea3733cf45eb41c091df941d90a15af7"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
